# Gateway and deployment
CODEX_MARITIME_TOKEN=replace-with-a-long-random-token
CODEX_MARITIME_GATEWAY_URL=http://127.0.0.1:8787
CODEX_MARITIME_PUBLIC_URL=https://your-maritime-service.example
CODEX_MARITIME_STATE_PATH=./data/state.json
PORT=8787

# Scheduling (production defaults)
CODEX_MARITIME_TIMEZONE=UTC
CODEX_MARITIME_FIRST_MINUTES=60
CODEX_MARITIME_REPEAT_MINUTES=120
CODEX_MARITIME_QUIET_ENABLED=true
CODEX_MARITIME_QUIET_START=00:00
CODEX_MARITIME_QUIET_END=06:00

# Primary provider: Sendblue
CODEX_MARITIME_CHANNEL=sendblue
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=+15551110000
SENDBLUE_RECIPIENT=+15552220000
SENDBLUE_WEBHOOK_SECRET=
CODEX_MARITIME_ALLOWED_SENDERS=+15552220000

# Optional compatibility provider: Inkbox
INKBOX_API_KEY=
INKBOX_PHONE_NUMBER_ID=
INKBOX_RECIPIENT=
INKBOX_SIGNING_KEY=
INKBOX_ALLOWED_SENDERS=

# Optional generic outbound bridge
CODEX_MARITIME_OUTBOUND_WEBHOOK_URL=
CODEX_MARITIME_OUTBOUND_WEBHOOK_TOKEN=
